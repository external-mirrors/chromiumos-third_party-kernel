+struct jenc_v4l2_format {
+	u32 type;
+	u32 fourcc;
+	u8  deept[JENC_HW_MAX_PLANES];
+	u8  x_div[JENC_HW_MAX_PLANES];
+	u8  y_div[JENC_HW_MAX_PLANES];
+	enum jenc_vid_id id;
+};
