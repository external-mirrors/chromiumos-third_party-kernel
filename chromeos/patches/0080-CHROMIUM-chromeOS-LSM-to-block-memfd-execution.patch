From 434dd002db26b0e9f12f093b72c7488a2cfb953e Mon Sep 17 00:00:00 2001
From: Jeff Xu <jeffxu@google.com>
Date: Fri, 7 Oct 2022 19:49:15 +0000
Subject: [PATCH 2/3] CHROMIUM: chromeOS LSM to block bpf_write_user

BPF can overwrite user memory and was used in root escalation.
Example: https://crbug.com/1320051

Currently ChromeOS doesn't use bpf_write_user, this LSM blocks
BPF programs that uses bpf_write_user.

BUG=b:251868129
TEST=load a BPF program with bpf_write_user, it is blocked.

Signed-off-by: Jeff Xu <jeffxu@google.com>
Change-Id: Ie48c93b775e45c5fcb05133f874758590fadd86f
Reviewed-on: https://chromium-review.googlesource.com/c/chromiumos/third_party/kernel/+/3939652
Reviewed-by: Guenter Roeck <groeck@chromium.org>

[rebase61(tzungbi):
    Squashed:
	Part of "CHROMIUM: Add logging for lsm"
]
Signed-off-by: Tzung-Bi Shih <tzungbi@chromium.org>

Change-Id: Iae3cadf99fc3828a5f7789eae73b7d28f6258943
---
 security/chromiumos/lsm.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/security/chromiumos/lsm.c b/security/chromiumos/lsm.c
index b64009523a31..8956ddf9c1b2 100644
--- a/security/chromiumos/lsm.c
+++ b/security/chromiumos/lsm.c
@@ -277,12 +277,23 @@ static int chromiumos_bprm_creds_for_exec(struct linux_binprm *bprm)
 	return 0;
 }
 
+static int chromiumos_locked_down(enum lockdown_reason what)
+{
+	if (what == LOCKDOWN_BPF_WRITE_USER) {
+		pr_notice_ratelimited("BPF_WRITE_USER blocked\n");
+		return -EACCES;
+	}
+
+	return 0;
+}
+
 static struct security_hook_list chromiumos_security_hooks[] = {
 	LSM_HOOK_INIT(sb_mount, chromiumos_security_sb_mount),
 	LSM_HOOK_INIT(inode_follow_link, chromiumos_security_inode_follow_link),
 	LSM_HOOK_INIT(file_open, chromiumos_security_file_open),
 	LSM_HOOK_INIT(sb_eat_lsm_opts, chromiumos_sb_eat_lsm_opts),
 	LSM_HOOK_INIT(bprm_creds_for_exec, chromiumos_bprm_creds_for_exec),
+	LSM_HOOK_INIT(locked_down, chromiumos_locked_down),
 };
 
 static int __init chromiumos_security_init(void)
-- 
