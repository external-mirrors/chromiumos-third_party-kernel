From 7b7628d5147547d6e2262771277cd373a9f461db Mon Sep 17 00:00:00 2001
From: Jeff Xu <jeffxu@google.com>
Date: Sat, 8 Oct 2022 01:40:01 +0000
Subject: [PATCH 3/3] CHROMIUM: restrict bpf to secagentd only

Restrict BPF to secagentd only.
This is a short term solution till ChromeOS secures
BPF to more processes.

BUG=b:251196147
TEST=manual test, non secagentd is blocked

Signed-off-by: Jeff Xu <jeffxu@google.com>
Change-Id: I2646e2370ee88e08a29e4378bc0767ff21310f26
Reviewed-on: https://chromium-review.googlesource.com/c/chromiumos/third_party/kernel/+/3938901
Reviewed-by: Guenter Roeck <groeck@chromium.org>
Reviewed-by: Aashay Shringarpure <aashay@google.com>

[rebase61(tzungbi):
    Squashed:
	CHROMIUM: ChromeOS LSM: add check for BPF_SYSCALL
	Part of "CHROMIUM: Add logging for lsm"
]
Signed-off-by: Tzung-Bi Shih <tzungbi@chromium.org>

Change-Id: I187b602c541e77678efca558bf715cb0029b6eff
---
 security/chromiumos/lsm.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/security/chromiumos/lsm.c b/security/chromiumos/lsm.c
index 8956ddf9c1b2..c8c89fa32056 100644
--- a/security/chromiumos/lsm.c
+++ b/security/chromiumos/lsm.c
@@ -27,6 +27,7 @@
 #include <linux/fs_parser.h>
 #include <linux/fs_struct.h>
 #include <linux/lsm_hooks.h>
+#include <linux/mm.h>
 #include <linux/module.h>
 #include <linux/mount.h>
 #include <linux/namei.h>	/* for nameidata_get_total_link_count */
@@ -287,6 +288,32 @@ static int chromiumos_locked_down(enum lockdown_reason what)
 	return 0;
 }
 
+#ifdef CONFIG_BPF_SYSCALL
+
+static const char secagentd[] = "/usr/sbin/secagentd";
+
+static int chromiumos_bpf(int cmd, union bpf_attr *attr, unsigned int size)
+{
+	char buf[128];
+	int res;
+	int len;
+
+	len = strlen(secagentd);
+	res = get_cmdline(current, buf, sizeof(buf));
+	if (res > 0 && buf[res - 1] == '\0') {
+		// null terminated.
+		res = res - 1;
+	}
+
+	if (res < len || strncmp(buf, secagentd, len)) {
+		pr_notice_ratelimited("bpf syscall blocked\n");
+		return -EACCES;
+	}
+
+	return 0;
+}
+#endif
+
 static struct security_hook_list chromiumos_security_hooks[] = {
 	LSM_HOOK_INIT(sb_mount, chromiumos_security_sb_mount),
 	LSM_HOOK_INIT(inode_follow_link, chromiumos_security_inode_follow_link),
@@ -294,6 +321,9 @@ static struct security_hook_list chromiumos_security_hooks[] = {
 	LSM_HOOK_INIT(sb_eat_lsm_opts, chromiumos_sb_eat_lsm_opts),
 	LSM_HOOK_INIT(bprm_creds_for_exec, chromiumos_bprm_creds_for_exec),
 	LSM_HOOK_INIT(locked_down, chromiumos_locked_down),
+#ifdef CONFIG_BPF_SYSCALL
+	LSM_HOOK_INIT(bpf, chromiumos_bpf),
+#endif
 };
 
 static int __init chromiumos_security_init(void)
-- 
