/dts-v1/;
#include "mt8196-rauru.dtsi"

/ {
	model = "Google Rauru board";
	compatible = "google,rauru", "mediatek,mt8196";
};

&nau8318 {
	status = "okay";
};

&nau8825 {
	status = "okay";
};

&afe {
	/* Only for ETDM in/out 4 */
	etdm-out-ch = <2>;
	etdm-in-ch = <2>;
	etdm-out-sync = <0>; /* 0: disable; 1: enable */
	etdm-in-sync = <0>; /* 0: disable; 1: enable */
	etdm-ip-mode = <0>; /* 0: One IP multi-channel 1: Multi-IP 2-channel */
	status = "okay";
};

&sound {
	compatible = "mediatek,mt8196-nau8825-sound";
	model = "mt8196_nau8318_8825";
	/*
	 * TODO: Remove deprecated mediatek,dai-link, use audio-routing and
	 * update UCM config.
	 **/
	mediatek,dai-link = "DL1_FE", "DL_24CH_FE",
			"UL0_FE", "UL2_FE", "UL26_FE", "I2SIN6_BE", "I2SOUT4_BE",
			"I2SOUT6_BE", "AP_DMIC_BE", "AP_DMIC_CH34_BE";
	status = "okay";

	dai-link-0 {
		link-name = "I2SOUT6_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&nau8825>;
		};
	};

	dai-link-1 {
		link-name = "I2SIN6_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&nau8825>;
		};
	};

	dai-link-2 {
		link-name = "I2SOUT4_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&nau8318>;
		};
	};
};

