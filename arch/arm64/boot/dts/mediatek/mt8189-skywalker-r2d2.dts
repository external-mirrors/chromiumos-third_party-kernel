&pmic {
	/delete-node/ mt6359codec;
};

&sound {
	compatible = "mediatek,mt8189-rt5682s-sound";
	model = "mt8189_1019_rt5682s";
	status = "okay";

	audio-routing = "I2SOUT1", "ETDMOUT_SPK_PIN",
			"I2SOUT0", "ETDMIN_HP_PIN",
			"I2SOUT0", "ETDMOUT_HP_PIN",
			"I2SIN0", "ETDMIN_HP_PIN",
			"I2SIN0", "ETDMOUT_HP_PIN",
			"IN1P", "Headset Mic",
			"PCM 0 Playback", "ETDMOUT_HDMI_PIN",
			"AP DMIC Capture", "AP_DMIC0_PIN",
			"AP DMIC CH34 Capture", "AP_DMIC1_PIN";

	dai-link-0 {
		link-name = "I2SOUT1_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&rt1019p>;
		};
	};

	dai-link-1 {
		link-name = "I2SOUT0_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&rt5682s>;
		};
	};

	dai-link-2 {
		link-name = "I2SIN0_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&rt5682s>;
		};
	};
};

&dp_tx {
	/delete-property/ mediatek,phy-flip-gpios;
};

&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&thermal_zones {
	tboard0-thermal {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor1>;

		trips {
			tboard1_temp_crit: tboard1_temp_crit@0 {
				temperature = <115000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	tboard1-thermal {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor2>;

		trips {
			tboard2_temp_crit: tboard2_temp_crit@0 {
				temperature = <115000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};
};

&threshold {
    temperature = <60000>;
};

&target {
    temperature = <70000>;
};

&u3phy0 {
	status = "okay";
};

&ufshci {
	status = "okay";
};

&usb_a1 {
	status = "disabled";
};

&usb_c1 {
	status = "disabled";
};

&keyboard_controller {
	keypad,num-columns = <18>;

	function-row-physmap = <
		MATRIX_KEY(0x00, 0x02, KEY_F1)	/* T1 */
		MATRIX_KEY(0x03, 0x02, KEY_F2)	/* T2 */
		MATRIX_KEY(0x02, 0x02, KEY_F3)	/* T3 */
		MATRIX_KEY(0x01, 0x02, KEY_F4)	/* T4 */
		MATRIX_KEY(0x04, 0x04, KEY_F5)	/* T5 */
		MATRIX_KEY(0x02, 0x04, KEY_F6)	/* T6 */
		MATRIX_KEY(0x01, 0x04, KEY_F7)	/* T7 */
		MATRIX_KEY(0x02, 0x0b, KEY_F8)	/* T8 */
		MATRIX_KEY(0x01, 0x09, KEY_F9)	/* T9 */
		MATRIX_KEY(0x00, 0x04, KEY_F10)	/* T10 */
		MATRIX_KEY(0x00, 0x01, KEY_F11)	/* T11 */
		MATRIX_KEY(0x01, 0x05, KEY_F12)	/* T12 */
		MATRIX_KEY(0x03, 0x05, KEY_F13)	/* T13 */
		MATRIX_KEY(0x03, 0x09, KEY_F14)	/* T14 */
	>;

	linux,keymap = <
		CROS_TOP_ROW_KEYMAP_V30
		CROS_MAIN_KEYMAP_V30
		MATRIX_KEY(0x00, 0x02, KEY_BACK)
		MATRIX_KEY(0x03, 0x02, KEY_REFRESH)
		MATRIX_KEY(0x02, 0x02, KEY_ZOOM)
		MATRIX_KEY(0x01, 0x02, KEY_SCALE)
		MATRIX_KEY(0x04, 0x04, KEY_SYSRQ)
		MATRIX_KEY(0x02, 0x04, KEY_BRIGHTNESSDOWN)
		MATRIX_KEY(0x01, 0x04, KEY_BRIGHTNESSUP)
		MATRIX_KEY(0x02, 0x0b, KEY_DICTATE)
		MATRIX_KEY(0x01, 0x09, KEY_ACCESSIBILITY)
		MATRIX_KEY(0x00, 0x04, KEY_PLAYPAUSE)
		MATRIX_KEY(0x00, 0x01, KEY_MICMUTE)
		MATRIX_KEY(0x01, 0x05, KEY_MUTE)
		MATRIX_KEY(0x03, 0x05, KEY_VOLUMEDOWN)
		MATRIX_KEY(0x03, 0x09, KEY_VOLUMEUP)
	>;
};

/* USB hub port 1 */
&usb_hub_dsp1_hs {
	remote-endpoint = <&usb_c0_hs>;
};

&usb_c0_hs {
	remote-endpoint = <&usb_hub_dsp1_hs>;
};

&usb_hub_dsp1_ss {
	remote-endpoint = <&usb_c0_ss>;
};

&usb_c0_ss {
	remote-endpoint = <&usb_hub_dsp1_ss>;
};

/* USB hub port 2 */
&usb_hub_dsp2_hs {
	remote-endpoint = <&usb_a0_hs>;
};

&usb_a0_hs {
	remote-endpoint = <&usb_hub_dsp2_hs>;
};

&usb_hub_dsp2_ss {
	remote-endpoint = <&usb_a0_ss>;
};

&usb_a0_ss {
	remote-endpoint = <&usb_hub_dsp2_ss>;
};

/* USB hub port 3 */
&usb_hub_dsp3_hs {
	remote-endpoint = <&usb_c1_hs>;
};

&usb_c1_hs {
	remote-endpoint = <&usb_hub_dsp3_hs>;
};

&usb_hub_dsp3_ss {
	remote-endpoint = <&usb_c1_ss>;
};

&usb_c1_ss {
	remote-endpoint = <&usb_hub_dsp3_ss>;
};

/* USB hub port 4 */
&usb_hub_dsp4_hs {
	status = "disabled";
};

&usb_a1_hs {
	status = "disabled";
};

&usb_hub_dsp4_ss {
	status = "disabled";
};

&usb_a1_ss {
	status = "disabled";
};

&mmc0 {
	status = "disabled";
};

&mmc1 {
	status = "disabled";
};

&mt6359_vufs_ldo_reg {
	regulator-always-on;
};

&xhci0 {
	status = "okay";
};

&xhci2 {
	status = "okay";
};

// Add WCAM, UCAM, Bluetooth
&u2port1{
	mediatek,pre-emphasis = <2>;
};

&u2port2{
	mediatek,pre-emphasis = <3>;
};

&u2port4{
	mediatek,pre-emphasis = <1>;
};
