/dts-v1/;
#include "mt8189-skywalker.dtsi"

/ {
	model = "Google Grogu board";
	compatible = "google,grogu", "mediatek,mt8189";
	chassis-type = "laptop";

	connector-hdmi {
		status = "disabled";
	};
};

&ap_i2c_aud {
	/delete-node/ audio-codec@1a;

	rt5650: audio-codec@1a {
		compatible = "realtek,rt5650";
		reg = <0x1a>;
		pinctrl-names = "default";
		pinctrl-0 = <&audio_codec_pins>;
		cbj-sleeve-gpio = <&pio 30 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pio 4 IRQ_TYPE_EDGE_BOTH>;
		#sound-dai-cells = <0>;
		realtek,dmic1-data-pin = <2>;
		realtek,jd-mode = <2>;
		status = "okay";
	};
};

&audio_codec_pins {
	pins-en-codec-pwr-soc {
		pinmux = <PINMUX_GPIO30__FUNC_GPIO30>;
		output-low;
	};
};

/* Disable support SAR */
&ap_i2c_sar {
	status = "disabled";
};

/* Disable support HDMI */
&ap_i2c_hdmi {
	status = "disabled";
};

/* trackpad */
&ap_i2c_tchpad {
	/delete-node/ trackpad@15;

	/* elan trackpad */
	trackpad_elan: trackpad@15 {
		compatible = "elan,ekth3000";
		reg = <0x15>;
		interrupts-extended = <&pio 125 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&trackpad_pins>;
		wakeup-source;
		hid-descr-addr = <0x0001>;
		vcc-supply = <&pp3300_s3>;
		status = "fail-needs-probe";
	};

	/* Focaltech trackpad */
	trackpad_focal: trackpad@38 {
		compatible = "hid-over-i2c";
		reg = <0x38>;
		interrupts-extended = <&pio 125 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&trackpad_pins>;
		wakeup-source;
		hid-descr-addr = <0x0001>;
		vdd-supply = <&pp3300_s3>;
		status = "fail-needs-probe";
	};
};

/* touchscreen */
&ap_i2c_tchscr {
	status = "disabled";

	/delete-node/ touchscreen@41;
};

&i2c4_pins {
	pins-bus {
		drive-strength = <4>;
	};
};

/* Disable support HDMI for MIPI DSI */
&dsi0 {
	status = "disabled";
};

/* Disable support PEN */
&gpio_keys {
	status = "disabled";
};

/* Same KB for Starros and Grogu. */
&keyboard_controller {
	keypad,num-columns = <18>;

	function-row-physmap = <
		MATRIX_KEY(0x00, 0x02, 0)		/* T1 */
		MATRIX_KEY(0x03, 0x02, 0)		/* T2 */
		MATRIX_KEY(0x02, 0x02, 0)		/* T3 */
		MATRIX_KEY(0x01, 0x02, 0)		/* T4 */
		MATRIX_KEY(0x04, 0x04, 0)		/* T5 */
		MATRIX_KEY(0x02, 0x04, 0)		/* T6 */
		MATRIX_KEY(0x01, 0x04, 0)		/* T7 */
		MATRIX_KEY(0x02, 0x0b, 0)		/* T8 */
		MATRIX_KEY(0x01, 0x09, 0)		/* T9 */
		MATRIX_KEY(0x00, 0x04, 0)		/* T10 */
		MATRIX_KEY(0x00, 0x01, 0)		/* T11 */
		MATRIX_KEY(0x01, 0x05, 0)		/* T12 */
	>;
};

/* Enable support EMMC */
&mmc0 {
	vmmc-supply = <&mt6359_vemc_1_ldo_reg>;
	vqmmc-supply = <&mt6359_vufs_ldo_reg>;

	status = "okay";
};

&mt6359_vufs_ldo_reg {
	regulator-always-on;
};

/* Disable support SD card */
&mmc1 {
	status = "disabled";
};

