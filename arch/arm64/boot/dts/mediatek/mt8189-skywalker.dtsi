/dts-v1/;
#include "mt8189.dtsi"
#include "mt8189-pinfunc.h"
#include "mt6319.dtsi"
#include "mt6359.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>

/ {
	/* chosen */
	chosen: chosen {
		stdout-path = "serial0:115200n8";
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pinctrl-names = "default";
		pinctrl-0 = <&backlight_en_pins>;
		pwms = <&disp_pwm0 0 500000>;
		power-supply = <&ppvar_sys>;
		enable-gpios = <&pio 13 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 1023>;
		num-interpolated-steps = <1023>;
		default-brightness-level = <576>;
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pen_eject_pins>;

		pen_insert: pen-insert-switch {
			label = "Pen Insert";
			/* Insert = low, eject = high */
			gpios = <&pio 11 GPIO_ACTIVE_LOW>;
			wakeup-event-action = <EV_ACT_DEASSERTED>;
			wakeup-source;
			linux,code = <SW_PEN_INSERTED>;
			linux,input-type = <EV_SW>;
		};
	};

	/* system wide semi-regulated power rail from battery or USB */
	ppvar_sys: regulator-ppvar-sys {
		compatible = "regulator-fixed";
		regulator-name = "ppvar_sys";
		regulator-always-on;
		regulator-boot-on;
	};

	/* system wide 3.3V power rail */
	pp3300_z1: regulator-pp3300-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_z1";
		/* controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&ppvar_sys>;
	};

	/* separately switched 3.3V power rail */
	pp3300_s3: regulator-pp3300-s3 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_s3";
		/* controlled by PMIC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&pp3300_z1>;
	};

	/* separately switched 3.3V power rail */
	pp3300_fp: regulator-pp3300-fp {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_fp";
		/* Always on to make fingerprint a wakeup source */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&fp_pwr_pins>;
		vin-supply = <&pp3300_z1>;
	};

	pp1000_hdmi_x: regulator-pp1000-hdmi-x {
		compatible = "regulator-fixed";
		regulator-name = "pp1000_hdmi_x";
		regulator-min-microvolt = <1000000>;
		regulator-max-microvolt = <1000000>;
		enable-active-high;
		regulator-enable-ramp-delay = <2000>;
		gpio = <&pio 135 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&hdmi_pwr_pins>;
		vin-supply = <&pp3300_z1>;
	};

	pp1800_tchscr_report_disable: regulator-pp1800-tchscr-report-disable {
		compatible = "regulator-fixed";
		regulator-name = "pp1800_tchscr_report_disable";
		pinctrl-names = "default";
		pinctrl-0 = <&touch_pin_report>;
		gpio = <&pio 14 GPIO_ACTIVE_LOW>;
	};

	pp3300_edp_x: regulator-pp3300-edp-x {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_edp_x";
		regulator-boot-on;
		off-on-delay-us = <500000>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&pio 25 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&edp_pwr_pins>;
		vin-supply = <&pp3300_z1>;
	};

	/* system wide 5.0V power rail */
	pp5000_z1: regulator-pp5000-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_z1";
		/* EN_PP5000_Z1 controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&ppvar_sys>;
	};

	/* separately switched 5.0V power rail */
	pp5000_usb: regulator-pp5000-usb {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_usb";
		regulator-always-on;
		enable-active-high;
		gpio = <&pio 131 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_init_done_pins>;
		vin-supply = <&pp5000_z1>;
	};

	connector-hdmi {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";
		pinctrl-names = "default";
		pinctrl-0 = <&hdmi_hpd_pins>;
		hpd-gpios = <&pio 139 GPIO_ACTIVE_LOW>;

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&it61620_hdmi_out>;
			};
		};
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		scp_mem_reserved: scp@50000000 {
			compatible = "shared-dma-pool";
			reg = <0 0x50000000 0 0x2900000>;
			no-map;
		};
	};

	rt9123: audio-codec {
		compatible = "richtek,rt9123p";
		pinctrl-names = "default";
		pinctrl-0 = <&audio_spk_en_pins>;
		enable-gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		status = "okay";
	};

	dmic_codec: dmic-codec {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
		num-channels = <2>;
		wakeup-delay-ms = <100>;
	};

	usb_a0: connector-0 {
		compatible = "usb-a-connector";
		vbus-supply = <&pp5000_usb>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				usb_a0_hs: endpoint { };
			};

			port@1 {
				reg = <1>;
				usb_a0_ss: endpoint { };
			};
		};
	};

	usb_a1: connector-1 {
		compatible = "usb-a-connector";
		vbus-supply = <&pp5000_usb>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				usb_a1_hs: endpoint { };
			};

			port@1 {
				reg = <1>;
				usb_a1_ss: endpoint { };
			};
		};
	};
};

/* TODO(treapking): Merge vnc33_*_wifi and vcn33_*_bt and update this. */
pp3300_ucam_x: &mt6359_vcn33_2_wifi_ldo_reg {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

pp3300_vio28_x: &mt6359_vio28_ldo_reg {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	/delete-property/ regulator-always-on;
};

pp1800_vcamio_x: &mt6359_vcamio_ldo_reg {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

pp3300_tchscr_x: &mt6359_vcn33_1_bt_ldo_reg {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&auxadc {
	status = "okay";
};

&cpuhvfs {
	proc1-supply = <&mt6359_vmodem_buck_reg>; //L
	proc2-supply = <&mt6319_7_vbuck1>; //B
	proc3-supply = <&mt6359_vmodem_buck_reg>; //DSU
};

&disp_dvo1{
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			disp1_dp_intf0_out: endpoint {
				remote-endpoint = <&dptx_in0>;
			};
		};
	};
};

&dp_tx {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&dp_hpd_pins>;

	mediatek,phy-flip-gpios = <&cros_ec 7 GPIO_ACTIVE_HIGH>;

	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dptx_in0: endpoint {
				remote-endpoint = <&disp1_dp_intf0_out>;
			};
		};

		port@1 {
			reg = <1>;
			dptx_out: endpoint {
				data-lanes = <0 1 2 3>;
			};
		};
	};
};

&disp_pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&disp_pwm0_pins>;
	status = "okay";
};

&disp_dvo0 {
	status = "okay";

	ports {
		port {
			disp_dvo0_out: endpoint {
				remote-endpoint = <&edp_in>;
			};
		};
	};
};

&edp_tx {
	pinctrl-names = "default";
	pinctrl-0 = <&edp_hpd_pins>;
	max-lane-count = <4>;
	max-linkrate-mhz = <5400>;
	use-aux-bus;

	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			edp_in: endpoint {
				remote-endpoint = <&disp_dvo0_out>;
			};
		};

		port@1 {
			reg = <1>;
			edp_out: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&edp_panel_in>;
			};
		};
	};

	aux-bus {
		panel: panel {
			compatible = "edp-panel";
			power-supply = <&pp3300_edp_x>;
			backlight = <&backlight>;

			status = "okay";

			port {
				edp_panel_in: endpoint {
					remote-endpoint = <&edp_out>;
				};
			};
		};
	};
};

&mt6359_vaud18_ldo_reg {
	regulator-always-on;
};

&gpu {
	supply-names = "mali";
	mali-supply = <&mt6359_vproc1_buck_reg>;
};

&scp {
	firmware-name = "mediatek/mt8189/scp.img";
	memory-region = <&scp_mem_reserved>;

	status = "okay";
};

&scpsys {
	mfg0-supply = <&mt6359_vproc1_buck_reg>;
	mfg1-supply = <&mt6359_vsram_proc1_ldo_reg>;
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;

	status = "okay";
};

&ufshci {
	vcc-supply = <&mt6359_vemc_1_ldo_reg>;
	vccq-supply = <&mt6359_vio18_ldo_reg>;
	vccq2-supply = <&mt6359_vufs_ldo_reg>;

	status = "okay";
};


scp_i2c_sensor: &i2c0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;

	status = "okay";
};

ap_i2c_aud: &i2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;

	status = "okay";

	nau8825: audio-codec@1a {
		compatible = "nuvoton,nau8825";
		reg = <0x1a>;
		interrupts-extended = <&pio 4 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&audio_codec_pins>;
		#sound-dai-cells = <0>;

		nuvoton,jkdet-enable;
		nuvoton,jkdet-polarity = <1>;
		nuvoton,vref-impedance = <2>;
		nuvoton,micbias-voltage = <6>;
		nuvoton,sar-threshold-num = <4>;
		nuvoton,sar-threshold = <0xc 0x1e 0x38 0x60>;
		nuvoton,sar-hysteresis = <1>;
		nuvoton,sar-voltage = <0>;
		nuvoton,sar-compare-time = <0>;
		nuvoton,sar-sampling-time = <0>;
		nuvoton,short-key-debounce = <2>;
		nuvoton,jack-insert-debounce = <7>;
		nuvoton,jack-eject-debounce = <7>;
		nuvoton,adc-delay-ms = <300>;
		status = "okay";
	};
};

ap_i2c_tpm: &i2c3 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;

	status = "okay";

	tpm@50 {
		/* TODO: Upstream adding the "ti50" compatible */
		compatible = "google,ti50", "google,cr50";
		reg = <0x50>;
		interrupts-extended = <&pio 138 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "default";
		pinctrl-0 = <&gsc_int_pin>;
	};
};

ap_i2c_tchscr: &i2c4 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;

	status = "okay";

	touchscreen@41 {
		compatible = "ilitek,ili2901";
		reg = <0x41>;

		interrupts-extended = <&pio 15 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_pins>;
		reset-gpios = <&pio 126 GPIO_ACTIVE_LOW>;
		vcc33-supply = <&pp3300_tchscr_x>;
		vccio-supply = <&pp1800_tchscr_report_disable>;
		status = "okay";
	};
};

ap_i2c_sar: &i2c5 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;

	status = "okay";

	ap_sar_sensor: proximity@28 {
		compatible = "semtech,sx9324";
		reg = <0x28>;
		interrupts-extended = <&pio 9 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&ap_sar_sensor_int>;
		pinctrl-names = "default";
		svdd-supply = <&mt6359_vio18_ldo_reg>;
		vdd-supply = <&mt6359_vio18_ldo_reg>;
		#io-channel-cells = <1>;
		status = "okay";
	};
};

ap_i2c_hdmi: &i2c6 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;

	status = "okay";

	hdmibrdg: ite61620@58 {
		compatible = "ite,it61620";
		reg = <0x58>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pio 128 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&it61620_pins>;
		reset-gpios = <&pio 127 GPIO_ACTIVE_LOW>;
		ivdd-supply = <&pp1000_hdmi_x>;
		ovdd-supply = <&pp3300_vio28_x>;
		ovdd1833-supply = <&pp1800_vcamio_x>;
		dsi-lanes = <4>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				it61620_dsi_in: endpoint {
					remote-endpoint = <&dsi_out>;
				};
			};

			port@1 {
				reg = <1>;
				it61620_hdmi_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&it61620_dsi_in>;
};

&mipi_tx_config0 {
	status = "okay";
};

ap_i2c_tchpad: &i2c7 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins>;

	status = "okay";

	trackpad: trackpad@15 {
		compatible = "hid-over-i2c";
		reg = <0x15>;
		interrupts-extended = <&pio 125 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&trackpad_pins>;
		wakeup-source;
		post-power-on-delay-ms = <10>;
		hid-descr-addr = <0x0001>;
		status = "okay";
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;

	status = "okay";

	cros_ec: ec@0 {
		compatible = "google,cros-ec-spi";
		reg = <0>;
		interrupts-extended = <&pio 132 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&ec_int_pins>;
		spi-max-frequency = <3000000>;

		#gpio-cells = <2>;
		gpio-controller;

		i2c_tunnel: i2c-tunnel {
			compatible = "google,cros-ec-i2c-tunnel";
			google,remote-bus = <4>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		typec {
			compatible = "google,cros-ec-ucsi";
			#address-cells = <1>;
			#size-cells = <0>;

			usb_c0: connector@0 {
				compatible = "usb-c-connector";
				reg = <0>;
				label = "left";
				power-role = "dual";
				data-role = "host";
				try-power-role = "source";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						usb_c0_hs: endpoint { };
					};

					port@1 {
						reg = <1>;

						usb_c0_ss: endpoint { };
					};
				};
			};

			usb_c1: connector@1 {
				compatible = "usb-c-connector";
				reg = <1>;
				label = "right";
				power-role = "dual";
				data-role = "host";
				try-power-role = "source";
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						usb_c1_hs: endpoint { };
					};

					port@1 {
						reg = <1>;

						usb_c1_ss: endpoint { };
					};
				};
			};
		};
	};
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;

	status = "okay";

	cros_ec_fp: ec@0 {
		compatible = "google,cros-ec-fp", "google,cros-ec-spi";
		reg = <0>;
		interrupts-extended = <&pio 129 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&fp_int_pin>, <&fp_rst_pin>, <&fp_fw_up_pin>;
		reset-gpios = <&pio 134 GPIO_ACTIVE_LOW>;
		boot0-gpios = <&pio 133 GPIO_ACTIVE_LOW>;
		spi-max-frequency = <3000000>;
		spi-cs-setup-delay-ns = <30>;
		vdd-supply = <&pp3300_fp>;
	};
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins>;

	status = "okay";
};

#include <arm/cros-ec-keyboard.dtsi>
#include <arm/cros-ec-sbs.dtsi>

&keyboard_controller {
	keypad,num-columns = <15>;

	function-row-physmap = <
		MATRIX_KEY(0x00, 0x02, 0)        /* T1 */
		MATRIX_KEY(0x03, 0x02, 0)        /* T2 */
		MATRIX_KEY(0x02, 0x02, 0)        /* T3 */
		MATRIX_KEY(0x01, 0x02, 0)        /* T4 */
		MATRIX_KEY(0x03, 0x04, 0)        /* T5 */
		MATRIX_KEY(0x02, 0x04, 0)        /* T6 */
		MATRIX_KEY(0x01, 0x04, 0)        /* T7 */
		MATRIX_KEY(0x02, 0x09, 0)        /* T8 */
		MATRIX_KEY(0x01, 0x09, 0)        /* T9 */
		MATRIX_KEY(0x00, 0x04, 0)        /* T10 */
		MATRIX_KEY(0x00, 0x01, 0)        /* T11 */
		MATRIX_KEY(0x01, 0x05, 0)        /* T12 */
	>;

	linux,keymap = <
		CROS_STD_MAIN_KEYMAP
		MATRIX_KEY(0x00, 0x02, KEY_BACK)           /* T1 */
		MATRIX_KEY(0x03, 0x02, KEY_REFRESH)        /* T2 */
		MATRIX_KEY(0x02, 0x02, KEY_ZOOM)           /* T3 */
		MATRIX_KEY(0x01, 0x02, KEY_SCALE)          /* T4 */
		MATRIX_KEY(0x03, 0x04, KEY_SYSRQ)          /* T5 */
		MATRIX_KEY(0x02, 0x04, KEY_BRIGHTNESSDOWN) /* T6 */
		MATRIX_KEY(0x01, 0x04, KEY_BRIGHTNESSUP)   /* T7 */
		MATRIX_KEY(0x02, 0x09, KEY_MUTE)           /* T8 */
		MATRIX_KEY(0x01, 0x09, KEY_VOLUMEDOWN)     /* T9 */
		MATRIX_KEY(0x00, 0x04, KEY_VOLUMEUP)       /* T10 */
		MATRIX_KEY(0x00, 0x01, KEY_MICMUTE)        /* T11 */
		MATRIX_KEY(0x01, 0x05, KEY_CONTROLPANEL)   /* T12 */
		MATRIX_KEY(0x03, 0x05, KEY_PREVIOUSSONG)   /* T13 */
		MATRIX_KEY(0x00, 0x09, KEY_PLAYPAUSE)      /* T14 */
		MATRIX_KEY(0x00, 0x0b, KEY_NEXTSONG)       /* T15 */
		MATRIX_KEY(0x03, 0x00, KEY_LEFTMETA)       /* Search*/
		MATRIX_KEY(0x01, 0x0e, KEY_LEFTCTRL)       /* Left Control*/
		MATRIX_KEY(0x06, 0x0d, KEY_LEFTALT)        /* Left ALT*/
		MATRIX_KEY(0x03, 0x0e, KEY_RIGHTCTRL)      /* Right Control*/
		MATRIX_KEY(0x06, 0x0a, KEY_BACKSLASH)      /* BACKSLASH*/
	>;
};

&pcie {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_pins>, <&wifi_pins>;

	status = "okay";
};

&pciephy {
	status = "okay";
};

&mt6359rtc {
	status = "okay";
};

&nor_flash {
	pinctrl-names = "default";
	pinctrl-0 = <&nor_pins>;

	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;
	};
};

