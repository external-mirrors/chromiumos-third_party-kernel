	ap_sar_sensor_int: ap-sar-sensor-int-pins {
		pins-sar-int-odl {
			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			input-enable;
			bias-pull-up;
		};
	};

	bt_pins: bt-pins {
		pin-bt-kill {
			pinmux = <PINMUX_GPIO145__FUNC_GPIO145>;
			output-high;
		};
	};

	uart0_pins: uart0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO31__FUNC_UTXD0>,
				 <PINMUX_GPIO32__FUNC_URXD0>;
			bias-pull-up;
		};
	};

	i2c0_pins: i2c0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO51__FUNC_SCP_SCL0>,
				 <PINMUX_GPIO52__FUNC_SCP_SDA0>;
			bias-disable;
		};
	};

	i2c2_pins: i2c2-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO55__FUNC_SCL2>,
				 <PINMUX_GPIO56__FUNC_SDA2>;
