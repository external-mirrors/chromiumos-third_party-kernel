				 <PINMUX_GPIO50__FUNC_CLKREQN>;
		};
	};

	ec_int_pins: ec-int-pins {
		pins-int {
			pinmux = <PINMUX_GPIO132__FUNC_GPIO132>;
			input-enable;
			bias-disable;
		};
	};

	disp_pwm0_pins: disp-pwm0-pins {
