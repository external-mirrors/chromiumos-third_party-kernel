			output-low;
		};
	};

	pen_eject_pins: pen-eject-pins {
		pins-eject {
			pinmux = <PINMUX_GPIO11__FUNC_GPIO11>;
			input-enable;
			/* External pull-up. */
			bias-disable;
		};
	};

	trackpad_pins: trackpad-pins {
		pins-int {
			pinmux = <PINMUX_GPIO125__FUNC_GPIO125>;
			input-enable;
			bias-disable;
		};
	};

	usb_init_done_pins: usb-init-done-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO131__FUNC_GPIO131>;
			output-low;
		};
	};

	wifi_pins: wifi-pins {
		pins-wifi-kill {
			pinmux = <PINMUX_GPIO146__FUNC_GPIO146>;
			output-high;
		};
	};

	audio_spk_en_pins: audio_spk_en_pins {
		pins-spk-en {
			pinmux = <PINMUX_GPIO5__FUNC_GPIO5>;
			output-low;
		};
	};

	audio_codec_pins: audio-codec-pins {
		pins-hp-int-odl {
			pinmux = <PINMUX_GPIO4__FUNC_GPIO4>;
			input-enable;
			bias-disable;
		};
	};

	/* AUDIO GPIO standardization start */
	/* Audio I2S Interface */
	aud_gpio_i2sin0_off: aud-gpio-i2sin0-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO106__FUNC_GPIO106>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_gpio_i2sin0_on: aud-gpio-i2sin0-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO106__FUNC_I2SIN0_DI>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	aud_gpio_i2sout0_off: aud-gpio-i2sout0-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO107__FUNC_GPIO107>;
			input-enable;
			bias-pull-down;
		};

