	it61620_pins: it61620-pins {
		pins-int {
			pinmux = <PINMUX_GPIO128__FUNC_GPIO128>;
			input-enable;
			bias-disable;
		};

		pins-reset {
			pinmux = <PINMUX_GPIO127__FUNC_GPIO127>;
			output-low;
			bias-pull-up;
		};
