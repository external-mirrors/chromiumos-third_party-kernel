	i2c7_pins: i2c7-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO65__FUNC_SCL7>,
				 <PINMUX_GPIO66__FUNC_SDA7>;
			drive-strength = <4>;
			bias-disable;
		};
	};

	spi0_pins: spi0-pins {
