/dts-v1/;
#include "mt8186-corsola-ponyta360.dtsi"

/ {
	model = "Google Ponyta sku131072 board";
	compatible = "google,ponyta-sku131072", "google,ponyta", "mediatek,mt8186";
};

&i2c1 {
	/* The actual IC is elan,ekth7b18uay, but elan,ekth6915 is compatible with it */
	touchscreen_elan: touchscreen@10 {
		compatible = "elan,ekth6915";
		reg = <0x10>;
		interrupts-extended = <&pio 12 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_pins>;
		panel = <&panel>;
		reset-gpios = <&pio 60 GPIO_ACTIVE_LOW>;
		vccio-supply = <&pp3300_s3>;
	};
};

&i2c2 {
	i2c-scl-internal-delay-ns = <22000>;

	trackpad@2d {
		compatible = "hid-over-i2c";
		reg = <0x2d>;
		hid-descr-addr = <0x20>;
		interrupts-extended = <&pio 11 IRQ_TYPE_LEVEL_LOW>;
		vcc-supply = <&pp3300_s3>;
		wakeup-source;
	};
};

&touchscreen_ilitek {
	status = "disabled";
};
