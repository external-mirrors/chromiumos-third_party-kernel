		"EMI_RESET_N";

	en_pp5900_mipi_disp: en-pp5900-mipi-disp {
		pins-en {
			pinmux = <PINMUX_GPIO14__FUNC_GPIO14>;
			output-low;
		};
	};

	panel_default_pins: panel-default-pins {
		pins-en {
			pinmux = <PINMUX_GPIO25__FUNC_GPIO25>;
			output-low;
		};
	};

	touchpad_pins: touchpad-pins {
		pins-int {
			pinmux = <PINMUX_GPIO141__FUNC_GPIO141>;
			input-enable;
			bias-disable;
		};
	};
};

&pmic {
	/delete-node/ mt6359codec;
};

&pp1800_tchscr_report_disable {
	status = "disabled";
};

&pp3300_edp_x {
	status = "disabled";
};

&rt9123 {
	status = "disabled";
};

&sound {
	compatible = "mediatek,mt8189-rt5682s-sound";
	model = "mt8189_35l51_rt5682s";
	status = "okay";

	audio-routing = "I2SOUT1", "ETDMOUT_SPK_PIN",
			"I2SOUT0", "ETDMIN_HP_PIN",
			"I2SOUT0", "ETDMOUT_HP_PIN",
			"I2SIN0", "ETDMIN_HP_PIN",
			"I2SIN0", "ETDMOUT_HP_PIN",
			"IN1P", "Headset Mic",
			"PCM 0 Playback", "ETDMOUT_HDMI_PIN",
			"AP DMIC Capture", "AP_DMIC0_PIN",
			"AP DMIC CH34 Capture", "AP_DMIC1_PIN";

	/delete-node/ dai-link-6;

	dai-link-0 {
		link-name = "I2SOUT1_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&cs35l51_r>,
				    <&cs35l51_l>;
		};
	};

	dai-link-1 {
		link-name = "I2SOUT0_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&rt5682s>;
		};
	};

	dai-link-2 {
		link-name = "I2SIN0_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&rt5682s>;
		};
	};

	dai-link-3 {
		link-name = "TDM_DPTX_BE";

		codec {
			sound-dai = <&dp_tx>;
		};
	};
};

&spi1 {
	status = "disabled";
};

&spi2 {
	touchscreen: touchscreen@0 {
		compatible = "tchip,ilitek";
		reg = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_pins>;
		reset-gpios = <&pio 126 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pio 15 IRQ_TYPE_EDGE_FALLING>;
		spi-max-frequency = <3000000>;
		spi-cs-setup-delay-ns = <30>;
		panel = <&mipi_panel>;

		input-report-header-address = <0x001000>;
		input-report-body-address   = <0x001000>;
		output-report-address       = <0x002000>;
		read-opcode                 = <0x83>;
		write-opcode                = <0x82>;
		post-power-on-delay-ms      = <0>;
		minimal-reset-delay-ms      = <10>;
		status = "okay";
	};
};

&thermal_zones {
	tboard0-thermal {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor1>;

		trips {
			tboard1_temp_crit: tboard1_temp_crit@0 {
				temperature = <115000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	tboard1-thermal {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor2>;

		trips {
			tboard2_temp_crit: tboard2_temp_crit@0 {
				temperature = <115000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};
};

&touchscreen_pins {
	pins-int {
		pinmux = <PINMUX_GPIO15__FUNC_GPIO15>;
		/delete-property/ bias-pull-up;
		input-enable;
	};

	pins-reset {
		pinmux = <PINMUX_GPIO126__FUNC_GPIO126>;
		/delete-property/ output-high;
		output-low;
	};
};

&trackpad {
	status = "disabled";
};

&u2port0 {
	mediatek,pre-emphasis = <3>;
};

&ufshci {
	status = "disabled";
};

&usb_c1 {
	status = "disabled";
};

&xhci0 {
	phys = <&u2port0 PHY_TYPE_USB2>,
	       <&u3port0 PHY_TYPE_USB3>;
	mediatek,u3p-dis-msk = <0x0>;
	status = "okay";
};

&xhci2 {
	vbus-supply = <&mt6359_vpa_buck_reg>;
};
