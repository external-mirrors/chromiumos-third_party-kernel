/dts-v1/;
#include "mt8189-skywalker.dtsi"

/ {
	tboard_thermistor1: thermal-sensor1 {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&auxadc 0>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <    (-5000) 1492
						0 1413
						5000 1324
						10000 1227
						15000 1121
						20000 1017
						25000 900
						30000 797
						35000 698
						40000 606
						45000 522
						50000 449
						55000 383
						60000 327
						65000 278
						70000 236
						75000 201
						80000 171
						85000 145
						90000 163
						95000 124
						100000 91
						105000 78
						110000 67
						115000 58
						120000 50
						125000 44>;
	};

	tboard_thermistor2: thermal-sensor2 {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		io-channels = <&auxadc 1>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <    (-5000) 1492
						0 1413
						5000 1324
						10000 1227
						15000 1121
						20000 1017
						25000 900
						30000 797
						35000 698
						40000 606
						45000 522
						50000 449
						55000 383
						60000 327
						65000 278
						70000 236
						75000 201
						80000 171
						85000 145
						90000 163
						95000 124
						100000 91
						105000 78
						110000 67
						115000 58
						120000 50
						125000 44>;
	};
};

&ap_i2c_aud {
	/delete-node/ audio-codec@1a;

	rt5682s: audio-codec@1a {
		compatible = "realtek,rt5682s";
		reg = <0x1a>;
		interrupts-extended = <&pio 4 IRQ_TYPE_EDGE_BOTH>;
		pinctrl-names = "default";
		pinctrl-0 = <&audio_codec_pins>;
		#sound-dai-cells = <0>;

		AVDD-supply = <&mt6359_vio18_ldo_reg>;
		DBVDD-supply = <&mt6359_vio18_ldo_reg>;
		LDO1-IN-supply = <&mt6359_vio18_ldo_reg>;
		MICVDD-supply = <&pp3300_z1>;
		realtek,jd-src = <1>;
		status = "okay";
	};
};

&ap_i2c_hdmi {
	aw37503_regulator: aw37503-regulator@3e {
		compatible = "awinic,aw37503";
		reg = <0x3e>;

		pp5900_mipi_disp_avdd: outp {
			regulator-name = "aw37503-outp";
			regulator-min-microvolt = <5900000>;
			regulator-max-microvolt = <5900000>;
			enable-active-high;
			enable-gpios = <&pio 14 GPIO_ACTIVE_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&en_pp5900_mipi_disp>;
		};

		pp5900_mipi_disp_avee: outn {
			regulator-name = "aw37503-outn";
			regulator-min-microvolt = <5900000>;
			regulator-max-microvolt = <5900000>;
		};
	};
};

&ap_i2c_tchscr {
	status = "disabled";
};

&backlight {
	pwms = <&disp_pwm0 0 1000000>;
};

&cros_ec {
	cbas {
		compatible = "google,cros-cbas";
		disable-whisker-input;
		hid-i2c-tp = <&trackpad>;
	};
};

&disp_dvo0 {
	status = "disabled";
};

&dispsys_config {
	compatible = "mediatek,mt8189-padme-mmsys", "syscon";
};

&dp_tx {
	/delete-property/ mediatek,phy-flip-gpios;
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	mediatek,is-cphy;

	mipi_panel: panel@0 {
		compatible = "tianma,il79900a";
		reg = <0>;
		enable-gpios = <&pio 25 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_default_pins>;
		avdd-supply = <&pp5900_mipi_disp_avdd>;
		avee-supply = <&pp5900_mipi_disp_avee>;
		pp1800-supply = <&mt6359_vcn18_ldo_reg>;
		backlight = <&backlight>;
		rotation = <270>;
		status = "okay";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

};

&dsi_out {
	remote-endpoint = <&panel_in>;
	data-lanes = <0 1 2>;
};

&edp_tx {
	status = "disabled";
};

&gpio_keys {
	status = "disabled";
};

&hdmibrdg {
	status = "disabled";
};

&i2c0 {
	touchpad: trackpad@56 {
		compatible = "hid-over-i2c";
		reg = <0x56>;
		hid-descr-addr = <0x0001>;
		interrupts-extended = <&pio 141 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&touchpad_pins>;
		wakeup-source;
		status = "okay";
	};
};

&i2c0_pins {
	pins-bus {
		pinmux = <PINMUX_GPIO51__FUNC_SCL0>,
			 <PINMUX_GPIO52__FUNC_SDA0>;
		bias-disable;
	};
};

&i2c7 {
	cs35l51_l: speaker-amp@40 {
		compatible = "cirrus,cs35l41";
		reg = <0x40>;
		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&pio 6 GPIO_ACTIVE_HIGH>;
		cirrus,boost-peak-milliamp = <4000>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <15>;
		cirrus,asp-sdout-hiz = <3>;
		cirrus,gpio2-src-select = <2>;
		cirrus,gpio2-output-enable;
		cirrus,subsystem-id = "104315ee";
		#sound-dai-cells = <0>;
	};

	cs35l51_r: speaker-amp@42 {
		compatible = "cirrus,cs35l41";
		reg = <0x42>;
		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&pio 6 GPIO_ACTIVE_HIGH>;
		cirrus,boost-peak-milliamp = <4000>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <15>;
		cirrus,asp-sdout-hiz = <3>;
		cirrus,gpio2-src-select = <2>;
		cirrus,gpio2-output-enable;
		cirrus,subsystem-id = "104315ee";
		#sound-dai-cells = <0>;
	};
};

&i2c_tunnel {
	/delete-node/ sbs-battery@b;
	battery: sbs-battery@f {
		compatible = "sbs,sbs-battery";
		reg = <0xf>;
		sbs,i2c-retry-count = <2>;
		sbs,poll-retry-count = <10>;
	};
};

&keyboard_controller {
	keypad,num-columns = <18>;

	function-row-physmap = <
		MATRIX_KEY(0x00, 0x02, 0)        /* T1 */
		MATRIX_KEY(0x03, 0x02, 0)        /* T2 */
		MATRIX_KEY(0x02, 0x02, 0)        /* T3 */
		MATRIX_KEY(0x01, 0x02, 0)        /* T4 */
		MATRIX_KEY(0x04, 0x04, 0)        /* T5 */
		MATRIX_KEY(0x02, 0x04, 0)        /* T6 */
		MATRIX_KEY(0x01, 0x04, 0)        /* T7 */
		MATRIX_KEY(0x02, 0x0b, 0)        /* T8 */
		MATRIX_KEY(0x01, 0x09, 0)        /* T9 */
		MATRIX_KEY(0x00, 0x04, 0)        /* T10 */
		MATRIX_KEY(0x00, 0x01, 0)        /* T11 */
		MATRIX_KEY(0x01, 0x05, 0)        /* T12 */
		MATRIX_KEY(0x03, 0x05, 0)        /* T13 */
		MATRIX_KEY(0x00, 0x0b, 0)        /* T14 */
	>;

	linux,keymap = <
		CROS_TOP_ROW_KEYMAP_V30
		CROS_MAIN_KEYMAP_V30
		MATRIX_KEY(0x00, 0x02, KEY_BACK)                 /* T1 */
		MATRIX_KEY(0x03, 0x02, KEY_REFRESH)              /* T2 */
		MATRIX_KEY(0x02, 0x02, KEY_ZOOM)                 /* T3 */
		MATRIX_KEY(0x01, 0x02, KEY_SCALE)                /* T4 */
		MATRIX_KEY(0x04, 0x04, KEY_SYSRQ)                /* T5 */
		MATRIX_KEY(0x02, 0x04, KEY_BRIGHTNESSDOWN)       /* T6 */
		MATRIX_KEY(0x01, 0x04, KEY_BRIGHTNESSUP)         /* T7 */
		MATRIX_KEY(0x02, 0x0b, KEY_DICTATE)              /* T8 */
		MATRIX_KEY(0x01, 0x09, KEY_PLAYPAUSE)            /* T9 */
		MATRIX_KEY(0x00, 0x04, KEY_MICMUTE)              /* T10 */
		MATRIX_KEY(0x00, 0x01, KEY_MUTE)                 /* T11 */
		MATRIX_KEY(0x01, 0x05, KEY_VOLUMEDOWN)           /* T12 */
		MATRIX_KEY(0x03, 0x05, KEY_VOLUMEUP)             /* T13 */
		MATRIX_KEY(0x00, 0x0b, KEY_ACCESSIBILITY)        /* T14 */
		MATRIX_KEY(0x02, 0x0a, KEY_YEN)                  /* JP ￥*/
		MATRIX_KEY(0x04, 0x0a, KEY_FN)                   /* FN ￥*/
		MATRIX_KEY(0x06, 0x0a, KEY_BACKSLASH)            /*UK #*/
		MATRIX_KEY(0x02, 0x07, KEY_102ND)                /*UK \\*/
	>;
};

&mipi_tx_config0 {
	mediatek,is-cphy;
	mediatek,pre-emphasis-en;

	drive-strength-microamp = <6000>;
};

&mmc0 {
	vmmc-supply = <&mt6359_vemc_1_ldo_reg>;
	vqmmc-supply = <&mt6359_vufs_ldo_reg>;

	status = "okay";
};

&mmc1 {
	status = "disabled";
};

&mt6359_vpa_buck_reg {
	regulator-min-microvolt = <900000>;
	regulator-max-microvolt = <900000>;
};

/* Use PMIC VFE28 for WFC 2.8V AF power supply */
&mt6359_vfe28_ldo_reg {
	regulator-always-on;
};

