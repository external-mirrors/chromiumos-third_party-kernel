/dts-v1/;

#include "socfpga_arria10_mercury_aa1.dts"

/ {
	model = "Google Chameleon V3";
	compatible = "google,chameleon-v3",
	             "altr,socfpga-arria10", "altr,socfpga";

	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
	};

	soc {
		video@c0050000 {
			compatible = "google,fb-chameleonv3";
			reg = <0xc0050000 0x1010>;
			interrupts = <0 19 IRQ_TYPE_LEVEL_HIGH>;
		};
	};
};

&uart0 {
	/* EC communications */
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	/* IO expander */
	u80: u80@21 {
		compatible = "nxp,pca9535";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"SOM_AUD_MUTE",
			"DP1_OUT_CEC_EN",
			"DP2_OUT_CEC_EN",
			"DP1_SOM_PS8469_CAD",
			"DPD_SOM_PS8469_CAD",
			"DP_OUT_PWR_EN",
			"STM32_RST_L",
			"STM32_BOOT0",

			"FPGA_PROT",
			"STM32_FPGA_COMM0",
			"TP119",
			"TP120",
			"TP121",
			"TP122",
			"TP123",
			"TP124";
	};
};
